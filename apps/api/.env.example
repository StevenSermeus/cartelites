PORT=3001
CONVEX_URL=http://127.0.0.1:3210
CONVEX_AUTH_SECRET=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=tcg-marge-private
R2_ACCESS_KEY_ID=replace-with-r2-credential
R2_SECRET_ACCESS_KEY=replace-with-r2-credential
ATTACHMENT_MAX_BYTES=10485760
# In-memory image cache per API process; set MAX_BYTES=0 to disable.
IMAGE_CACHE_MAX_BYTES=67108864
IMAGE_CACHE_TTL_SECONDS=300
# Optional Brevo transactional emails; blank values disable email delivery.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
JWT_ISSUER=http://127.0.0.1:3001
JWT_AUDIENCE=tcg-marge-clients
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_TTL_SECONDS=3600
SESSION_REFRESH_INTERVAL_SECONDS=900
WEB_ORIGIN=http://localhost:5174
COOKIE_SECURE=false
