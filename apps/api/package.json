{
  "name": "@tcg-marge/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm receipt:identity && pnpm shop:config && node --env-file=.env --import tsx --watch src/index.ts",
    "seed:demo": "node --env-file=.env --import tsx scripts/seed-demo.ts",
    "build": "pnpm receipt:identity && pnpm shop:config && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "receipt:identity": "node --import tsx scripts/generate-receipt-identity.ts",
    "shop:config": "node --import tsx scripts/generate-shop-config.ts",
    "migration:rehearse": "tsx scripts/migration/rehearse.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "^0.18.4",
    "argon2": "^0.41.1",
    "cheerio": "1.2.0",
    "convex": "^1.17.4",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}
