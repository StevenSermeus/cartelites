{
  "expo": {
    "name": "TVA sur marge",
    "slug": "tcg-marge",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.wdee.cartelites",
      "supportsTablet": true,
      "buildNumber": "3"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisissez une photo pour documenter un article.",
          "cameraPermission": "Prenez une photo pour documenter un article.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
