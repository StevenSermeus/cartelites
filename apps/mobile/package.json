{
  "name": "@tcg-marge/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "ios": "APP_VARIANT=development expo prebuild --clean --platform ios && APP_VARIANT=development expo run:ios",
    "ios:release": "APP_VARIANT=production expo prebuild --clean --platform ios && APP_VARIANT=production expo run:ios --configuration Release",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@tcg-marge/domain": "workspace:*",
    "@tcg-marge/realtime": "workspace:*",
    "expo": "~58.0.0",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-blob-util": "^1.1.1",
    "react-native-pdf": "^7.0.5",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
