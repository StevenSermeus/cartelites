# Copy to .env.docker and fill in your own production values.
# Existing Convex Cloud production deployment; the container deploys its functions.
CONVEX_DEPLOY_KEY=
CONVEX_URL=https://your-production-deployment.convex.cloud
CONVEX_AUTH_SECRET=

# Public URL served by your external HTTPS reverse proxy, without a trailing slash.
WEB_ORIGIN=https://cards.example.com
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=tcg-marge-clients
# PEM values on one line with literal \n separators, enclosed in single quotes.
JWT_PRIVATE_KEY_PEM=''
JWT_PUBLIC_KEY_PEM=''
JWT_TTL_SECONDS=3600
SESSION_REFRESH_INTERVAL_SECONDS=900

# External reverse proxy on the host -> http://127.0.0.1:8080
WEB_BIND_IP=127.0.0.1
WEB_PORT=8080
# API hostname -> http://127.0.0.1:3001
API_BIND_IP=127.0.0.1
API_PORT=3001

R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=tcg-marge-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ATTACHMENT_MAX_BYTES=10485760
# Allow multipart requests larger than ATTACHMENT_MAX_BYTES in the external proxy.

# Optional Brevo transactional emails. Leave blank until ready to enable.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
